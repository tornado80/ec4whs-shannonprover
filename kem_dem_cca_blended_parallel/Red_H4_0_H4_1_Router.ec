(* Red_H4_0_H4_1_Router.ec for theorem `kem_dem_cca_blended_parallel`, the reduction `H4_0 ~ H4_1` to assumption `CCA_DEM`: the router and the invariant — generated by `domino easycrypt`. *)
(* Left side: assumption game `CCA_DEM_0`, with the assumption arguments (false). *)
(* Right side: assumption game `CCA_DEM_1`, with the assumption arguments (true). *)
(* Reduction packages (left ~ right): Reduction_DEM ~ Reduction_DEM, Scheme_KEM ~ Scheme_KEM. The router uses the left names. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Pkg_Scheme_KEM Pkg_Reduction_DEM Comp_Hybrid2 Comp_Composition_CCA_DEM.

clone Pkg_Scheme_KEM as Cloned_Pkg_Scheme_KEM.

clone Pkg_Reduction_DEM as Cloned_Pkg_Reduction_DEM.

module Pkg_Inst_Scheme_KEM = Cloned_Pkg_Scheme_KEM.Scheme_KEM.

module Pkg_Imports_Reduction_DEM (O : Interfaces.Iface_Composition_CCA_DEM) : Pkg_Reduction_DEM.Reduction_DEM_Imports = {
  proc d_DEC(c_ : bits_dctl) : bits_ptl option = {
    var r : bits_ptl option;
    r <@ O.d_DEC(c_);
    return r;
  }

  proc d_DEM_DEC(k : bits_dkeyl, c : bits_dctl) : bits_ptl option = {
    var r : bits_ptl option;
    r <@ O.d_DEM_DEC(k, c);
    return r;
  }

  proc d_ENC(m0 : bits_ptl, m1 : bits_ptl) : bits_dctl option = {
    var r : bits_dctl option;
    r <@ O.d_ENC(m0, m1);
    return r;
  }

  proc d_KEM_DECAPS(sk : bits_skeyl, c : bits_kctl) : bits_dkeyl option option = {
    var r : bits_dkeyl option option;
    r <@ Pkg_Inst_Scheme_KEM.d_KEM_DECAPS(sk, c);
    return r;
  }

  proc d_KEM_ENCAPS(pk : bits_pkeyl) : (bits_dkeyl * bits_kctl) option = {
    var r : (bits_dkeyl * bits_kctl) option;
    r <@ Pkg_Inst_Scheme_KEM.d_KEM_ENCAPS(pk);
    return r;
  }

  proc d_KEM_GEN() : (bits_pkeyl * bits_skeyl) option = {
    var r : (bits_pkeyl * bits_skeyl) option;
    r <@ Pkg_Inst_Scheme_KEM.d_KEM_GEN();
    return r;
  }
}.

module Pkg_Inst_Reduction_DEM (O : Interfaces.Iface_Composition_CCA_DEM) = Cloned_Pkg_Reduction_DEM.Reduction_DEM(Pkg_Imports_Reduction_DEM(O)).

module Red_H4_0_H4_1 (O : Interfaces.Iface_Composition_CCA_DEM) : Interfaces.Iface_Composition_CCA_PKE = {
  var abort_flag : bool

  proc init() : unit = {
    abort_flag <- false;
    Pkg_Inst_Scheme_KEM.init();
    Pkg_Inst_Reduction_DEM(O).init();
  }

  proc d_PKGEN() : bits_pkeyl option = {
    var ec_result : bits_pkeyl option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_DEM(O).d_PKGEN();
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_PKENC(m0 : bits_ptl, m1 : bits_ptl) : (bits_kctl * bits_dctl) option = {
    var ec_result : (bits_kctl * bits_dctl) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_DEM(O).d_PKENC(m0, m1);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_PKDEC(c_ : (bits_kctl * bits_dctl)) : bits_ptl option option = {
    var ec_result : bits_ptl option option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_DEM(O).d_PKDEC(c_);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

op inv_H4_0_H4_1 (game_abort : bool) (red_abort : bool) (assm_abort : bool) (x0_l : (glob Comp_Hybrid2.Cloned_Pkg_Scheme_KEM.Scheme_KEM)) (x0_r : (glob Cloned_Pkg_Scheme_KEM.Scheme_KEM)) (x1_l : (glob Comp_Hybrid2.Cloned_Pkg_Reduction_DEM.Reduction_DEM)) (x1_r : (glob Cloned_Pkg_Reduction_DEM.Reduction_DEM)) (x2_l : (glob Comp_Hybrid2.Cloned_Pkg_Scheme_DEM.Scheme_DEM)) (x2_r : (glob Comp_Composition_CCA_DEM.Cloned_Pkg_Scheme_DEM.Scheme_DEM)) (x3_l : (glob Comp_Hybrid2.Cloned_Pkg_CCA_DEM.CCA_DEM)) (x3_r : (glob Comp_Composition_CCA_DEM.Cloned_Pkg_CCA_DEM.CCA_DEM)) : bool =
     game_abort = red_abort
  /\ (   assm_abort
      => red_abort)
  /\ x0_l = x0_r
  /\ x1_l = x1_r
  /\ x2_l = x2_r
  /\ x3_l = x3_r.
