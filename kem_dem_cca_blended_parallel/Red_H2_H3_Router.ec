(* Red_H2_H3_Router.ec for theorem `kem_dem_cca_blended_parallel`, the reduction `H2 ~ H3` to assumption `CCA_KEM`: the router and the invariant — generated by `domino easycrypt`. *)
(* Left side: assumption game `CCA_KEM_0`, with the assumption arguments (false). *)
(* Right side: assumption game `CCA_KEM_1`, with the assumption arguments (true). *)
(* Reduction packages (left ~ right): Reduction_KEM ~ Reduction_KEM, Scheme_DEM ~ Scheme_DEM. The router uses the left names. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Pkg_Scheme_DEM Pkg_Reduction_KEM Comp_Hybrid1 Comp_Composition_CCA_KEM.

clone Pkg_Scheme_DEM as Cloned_Pkg_Scheme_DEM.

clone Pkg_Reduction_KEM as Cloned_Pkg_Reduction_KEM.

module Pkg_Inst_Scheme_DEM = Cloned_Pkg_Scheme_DEM.Scheme_DEM.

module Pkg_Imports_Reduction_KEM (O : Interfaces.Iface_Composition_CCA_KEM) : Pkg_Reduction_KEM.Reduction_KEM_Imports = {
  proc d_DECAPS(c : bits_kctl) : bits_dkeyl option option = {
    var r : bits_dkeyl option option;
    r <@ O.d_DECAPS(c);
    return r;
  }

  proc d_DEM_DEC(k : bits_dkeyl, c : bits_dctl) : bits_ptl option = {
    var r : bits_ptl option;
    r <@ Pkg_Inst_Scheme_DEM.d_DEM_DEC(k, c);
    return r;
  }

  proc d_DEM_ENC(k : bits_dkeyl, m : bits_ptl) : bits_dctl option = {
    var r : bits_dctl option;
    r <@ Pkg_Inst_Scheme_DEM.d_DEM_ENC(k, m);
    return r;
  }

  proc d_ENCAPS() : (bits_kctl * bits_dkeyl) option = {
    var r : (bits_kctl * bits_dkeyl) option;
    r <@ O.d_ENCAPS();
    return r;
  }

  proc d_KEMGEN() : bits_pkeyl option = {
    var r : bits_pkeyl option;
    r <@ O.d_KEMGEN();
    return r;
  }
}.

module Pkg_Inst_Reduction_KEM (O : Interfaces.Iface_Composition_CCA_KEM) = Cloned_Pkg_Reduction_KEM.Reduction_KEM(Pkg_Imports_Reduction_KEM(O)).

module Red_H2_H3 (O : Interfaces.Iface_Composition_CCA_KEM) : Interfaces.Iface_Composition_CCA_PKE = {
  var abort_flag : bool

  proc init(bDem : bool) : unit = {
    abort_flag <- false;
    Pkg_Inst_Reduction_KEM(O).init(bDem);
  }

  proc d_PKGEN() : bits_pkeyl option = {
    var ec_result : bits_pkeyl option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_KEM(O).d_PKGEN();
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_PKENC(m0 : bits_ptl, m1 : bits_ptl) : (bits_kctl * bits_dctl) option = {
    var ec_result : (bits_kctl * bits_dctl) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_KEM(O).d_PKENC(m0, m1);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_PKDEC(c_ : (bits_kctl * bits_dctl)) : bits_ptl option option = {
    var ec_result : bits_ptl option option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_Reduction_KEM(O).d_PKDEC(c_);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

op inv_H2_H3 (game_abort : bool) (red_abort : bool) (assm_abort : bool) (x0_l : (glob Comp_Hybrid1.Cloned_Pkg_Scheme_DEM.Scheme_DEM)) (x0_r : (glob Cloned_Pkg_Scheme_DEM.Scheme_DEM)) (x1_l : (glob Comp_Hybrid1.Cloned_Pkg_Reduction_KEM.Reduction_KEM)) (x1_r : (glob Cloned_Pkg_Reduction_KEM.Reduction_KEM)) (x2_l : (glob Comp_Hybrid1.Cloned_Pkg_Scheme_KEM.Scheme_KEM)) (x2_r : (glob Comp_Composition_CCA_KEM.Cloned_Pkg_Scheme_KEM.Scheme_KEM)) (x3_l : (glob Comp_Hybrid1.Cloned_Pkg_CCA_KEM.CCA_KEM)) (x3_r : (glob Comp_Composition_CCA_KEM.Cloned_Pkg_CCA_KEM.CCA_KEM)) : bool =
     game_abort = red_abort
  /\ (   assm_abort
      => red_abort)
  /\ x0_l = x0_r
  /\ x1_l = x1_r
  /\ x2_l = x2_r
  /\ x3_l = x3_r.
