(* generated by domino: invariant for H3 ~ H4 *)

require import AllCore Distr FMap Int IntDiv Types.
require import Pkg_Scheme_KEM Pkg_CCA_KEM Pkg_Reduction_KEM Pkg_CCA_DEM Pkg_Reduction_DEM.

type H3_state = {
  l_pkg_Scheme_KEM : Scheme_KEM_pkgstate;
  l_pkg_CCA_KEM : CCA_KEM_pkgstate;
  l_pkg_Reduction_KEM : Reduction_KEM_pkgstate;
  l_pkg_CCA_KEM_b : bool;
  l_pkg_Reduction_KEM_b : bool;
  l_abort_flag : bool
}.

type H4_state = {
  r_pkg_Scheme_KEM : Scheme_KEM_pkgstate;
  r_pkg_CCA_DEM : CCA_DEM_pkgstate;
  r_pkg_Reduction_DEM : Reduction_DEM_pkgstate;
  r_pkg_CCA_DEM_b : bool;
  r_abort_flag : bool
}.

(* skipped `define-fun randomness-mapping-PKENC` (randomness mapping, not translated) *)

op StateRelation_invariant (l : H3_state) (r : H4_state) : bool =
     l.`l_pkg_Scheme_KEM.`Scheme_KEM_st = r.`r_pkg_Scheme_KEM.`Scheme_KEM_st
  /\ l.`l_pkg_CCA_KEM.`CCA_KEM_pk = l.`l_pkg_Reduction_KEM.`Reduction_KEM_pk
  /\ l.`l_pkg_Reduction_KEM.`Reduction_KEM_pk = r.`r_pkg_Reduction_DEM.`Reduction_DEM_pk
  /\ l.`l_pkg_CCA_KEM.`CCA_KEM_sk = r.`r_pkg_Reduction_DEM.`Reduction_DEM_sk
  /\ l.`l_pkg_Reduction_KEM.`Reduction_KEM_c = r.`r_pkg_Reduction_DEM.`Reduction_DEM_c
  /\ l.`l_pkg_Reduction_KEM.`Reduction_KEM_k = r.`r_pkg_CCA_DEM.`CCA_DEM_k
  /\ (l.`l_pkg_CCA_KEM.`CCA_KEM_pk = None) = (l.`l_pkg_CCA_KEM.`CCA_KEM_sk = None)
  /\ (l.`l_pkg_CCA_KEM.`CCA_KEM_c = None) = (r.`r_pkg_Reduction_DEM.`Reduction_DEM_c = None)
  /\ (r.`r_pkg_Reduction_DEM.`Reduction_DEM_c = None) = (r.`r_pkg_CCA_DEM.`CCA_DEM_k = None)
  /\ (r.`r_pkg_CCA_DEM.`CCA_DEM_k = None) = (r.`r_pkg_CCA_DEM.`CCA_DEM_c = None)
  /\ (   !(l.`l_pkg_Reduction_KEM.`Reduction_KEM_c = None)
      =>    oget l.`l_pkg_CCA_KEM.`CCA_KEM_c = (oget l.`l_pkg_Reduction_KEM.`Reduction_KEM_c).`1
         /\ oget r.`r_pkg_CCA_DEM.`CCA_DEM_c = (oget r.`r_pkg_Reduction_DEM.`Reduction_DEM_c).`2).

op params_inv (l : H3_state) (r : H4_state) : bool =
     l.`l_pkg_CCA_KEM_b = true
  /\ l.`l_pkg_Reduction_KEM_b = r.`r_pkg_CCA_DEM_b.

op inv (l : H3_state) (r : H4_state) : bool =
     params_inv l r
  /\ l.`l_abort_flag = r.`r_abort_flag
  /\ (   !l.`l_abort_flag
      => StateRelation_invariant l r).
