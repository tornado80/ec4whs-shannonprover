op StateRelation_invariant (l : H1_state) (r : H2_state) : bool =
     l.`l_pkg_Scheme_KEM.`Scheme_KEM_st = r.`r_pkg_Scheme_KEM.`Scheme_KEM_st
  /\ l.`l_pkg_Correct_KEM.`Correct_KEM_pk = r.`r_pkg_CCA_KEM.`CCA_KEM_pk
  /\ r.`r_pkg_CCA_KEM.`CCA_KEM_pk = r.`r_pkg_Reduction_KEM.`Reduction_KEM_pk
  /\ l.`l_pkg_Correct_KEM.`Correct_KEM_sk = r.`r_pkg_CCA_KEM.`CCA_KEM_sk
  /\ l.`l_pkg_Correct_KEM.`Correct_KEM_c = r.`r_pkg_CCA_KEM.`CCA_KEM_c
  /\ l.`l_pkg_Correct_KEM.`Correct_KEM_k = r.`r_pkg_Reduction_KEM.`Reduction_KEM_k
  /\ l.`l_pkg_Reduction_Correct_KEM.`Reduction_Correct_KEM_c = r.`r_pkg_Reduction_KEM.`Reduction_KEM_c
  /\ (l.`l_pkg_Correct_KEM.`Correct_KEM_pk = None) = (l.`l_pkg_Correct_KEM.`Correct_KEM_sk = None)
  /\ (l.`l_pkg_Correct_KEM.`Correct_KEM_sk = None) = (l.`l_pkg_Reduction_Correct_KEM.`Reduction_Correct_KEM_pk = None)
  /\ (l.`l_pkg_Correct_KEM.`Correct_KEM_c = None) = (l.`l_pkg_Reduction_Correct_KEM.`Reduction_Correct_KEM_c = None)
  /\ (   !(l.`l_pkg_Reduction_Correct_KEM.`Reduction_Correct_KEM_c = None)
      => oget l.`l_pkg_Correct_KEM.`Correct_KEM_c = (oget l.`l_pkg_Reduction_Correct_KEM.`Reduction_Correct_KEM_c).`1).

op params_inv (l : H1_state) (r : H2_state) : bool =
     l.`l_pkg_Correct_KEM_b = true
  /\ r.`r_pkg_CCA_KEM_b = false
  /\ l.`l_pkg_Reduction_Correct_KEM_b = r.`r_pkg_Reduction_KEM_b.

op inv (l : H1_state) (r : H2_state) : bool =
     params_inv l r
  /\ l.`l_abort_flag = r.`r_abort_flag
  /\ (   !l.`l_abort_flag
      => StateRelation_invariant l r).
