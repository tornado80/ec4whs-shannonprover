type H1_state = {
  l_pkg_Scheme_KEM : Scheme_KEM_pkgstate;
  l_pkg_Correct_KEM : Correct_KEM_pkgstate;
  l_pkg_Reduction_Correct_KEM : Reduction_Correct_KEM_pkgstate;
  l_pkg_Correct_KEM_b : bool;
  l_pkg_Reduction_Correct_KEM_b : bool;
