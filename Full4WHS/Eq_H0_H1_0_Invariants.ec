(* generated by domino: invariant for H0 ~ H1_0 *)

require import AllCore Distr FMap Int IntDiv Types.
require import Pkg_KX Pkg_Nonces.

type H0_state = {
  l_pkg_KX : KX_pkgstate;
  l_pkg_KX_b : bool;
  l_abort_flag : bool
}.

type H1_0_state = {
  r_pkg_Nonces : Nonces_pkgstate;
  r_pkg_KX : KX_pkgstate;
  r_pkg_Nonces_b : bool;
  r_pkg_KX_b : bool;
  r_abort_flag : bool
}.

op StateRelation_invariant (l : H0_state) (r : H1_0_state) : bool =
  l.`l_pkg_KX = r.`r_pkg_KX.

(* skipped `define-fun randomness-mapping-Send1` (randomness mapping, not translated) *)

(* skipped `define-fun randomness-mapping-Send2` (randomness mapping, not translated) *)

op params_inv (l : H0_state) (r : H1_0_state) : bool =
     r.`r_pkg_Nonces_b = false
  /\ l.`l_pkg_KX_b = r.`r_pkg_KX_b.

op inv (l : H0_state) (r : H1_0_state) : bool =
     params_inv l r
  /\ l.`l_abort_flag = r.`r_abort_flag
  /\ (   !l.`l_abort_flag
      => StateRelation_invariant l r).
