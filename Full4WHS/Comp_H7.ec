    r <@ Pkg_Inst_PRF.d_Hon(h);
    return r;
  }

  proc d_Run1(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option;
    r <@ Pkg_Inst_Prot.d_Run1(state);
    return r;
  }

  proc d_Run2(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), ni : bits_n) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option;
    r <@ Pkg_Inst_Prot.d_Run2(state, ni);
    return r;
  }

  proc d_Run3(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), msg : (bits_n * bits_n)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option;
    r <@ Pkg_Inst_Prot.d_Run3(state, msg);
    return r;
  }

  proc d_Run4(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), msg : (bits_n * bits_n)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option;
    r <@ Pkg_Inst_Prot.d_Run4(state, msg);
    return r;
  }

  proc d_Run5(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), tau : bits_n) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bool) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bool) option;
    r <@ Pkg_Inst_Prot.d_Run5(state, tau);
    return r;
  }
}.

module Pkg_Inst_KX = Cloned_Pkg_KX.KX_noprfkey(Pkg_Imports_KX).

module Game_H7 : Interfaces.Iface_H0 = {
  var abort_flag : bool

  proc init(bleast : bool, bmac : bool, btest : bool) : unit = {
    abort_flag <- false;
    Pkg_Inst_PRF.init(true);
    Pkg_Inst_MAC.init(bmac);
    Pkg_Inst_Nonces.init(true);
    Pkg_Inst_KX.init(btest, bleast);
  }

  proc d_NewKey(ltk : bits_n option) : int option = {
    var ec_result : int option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_PRF.d_NewKey(ltk);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_NewSession(d_U : int, u : bool, d_V : int, kid : int) : int option = {
    var ec_result : int option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_NewSession(d_U, u, d_V, kid);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send1(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send1(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send2(ctr : int, msg : bits_n) : (bits_n * bits_n) option = {
    var ec_result : (bits_n * bits_n) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send2(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send3(ctr : int, msg : (bits_n * bits_n)) : (bits_n * bits_n) option = {
    var ec_result : (bits_n * bits_n) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send3(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send4(ctr : int, msg : (bits_n * bits_n)) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send4(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send5(ctr : int, msg : bits_n) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send5(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Reveal(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Reveal(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Test(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Test(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_SameKey(ctr1 : int, ctr2 : int) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_SameKey(ctr1, ctr2);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_AtMost(ctr1 : int, ctr2 : int, ctr3 : int) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_AtMost(ctr1, ctr2, ctr3);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_AtLeast(sid : (int * int * bits_n * bits_n * bits_n)) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_AtLeast(sid);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

module Exp_H7 (A : Interfaces.Adv_H0) = {
  proc run(bleast : bool, bmac : bool, btest : bool) : bool = {
    var b' : bool;
    Game_H7.init(bleast, bmac, btest);
    b' <@ A(Game_H7).run();
    return b';
  }
}.

type H7_side = {
  H7_pkg_PRF : PRF_pkgstate;
  H7_pkg_MAC : MAC_pkgstate;
  H7_pkg_Nonces : Nonces_pkgstate;
  H7_pkg_KX : KX_noprfkey_pkgstate;
  H7_params_PRF : PRF_pkgparams;
  H7_params_MAC : MAC_pkgparams;
  H7_params_Nonces : Nonces_pkgparams;
  H7_params_Prot : ReductionMac_pkgparams;
  H7_params_KX : KX_noprfkey_pkgparams;
  H7_const_bleast : bool;
  H7_const_bmac : bool;
  H7_const_btest : bool;
  H7_abort_flag : bool
}.

op links_H7 (s : H7_side) : bool =
     s.`H7_params_PRF.`PRF_param_b = true
  /\ s.`H7_params_MAC.`MAC_param_b = s.`H7_const_bmac
  /\ s.`H7_params_Nonces.`Nonces_param_b = true
  /\ s.`H7_params_KX.`KX_noprfkey_param_btest = s.`H7_const_btest
  /\ s.`H7_params_KX.`KX_noprfkey_param_bleast = s.`H7_const_bleast.

op GameInv_first__points__to__state_of_H7 (g : H7_side) : bool =
  forall (sid : (int * int * bits_n * bits_n * bits_n)),
    let d_first = g.`H7_pkg_KX.`KX_noprfkey_d_First.[sid] in
         !(d_first = None)
      => let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[oget d_first] in
              !(state = None)
           /\ (oget state).`10 = Some sid.

op GameInv_first__entry__after__message1_of_H7 (g : H7_side) : bool =
  forall (sid : (int * int * bits_n * bits_n * bits_n)),
    let d_first = g.`H7_pkg_KX.`KX_noprfkey_d_First.[sid] in
         !(d_first = None)
      => let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[oget d_first] in
              !(state = None)
           => 1 < (oget state).`11.

op GameInv_keys__above__counter__empty_of_H7 (g : H7_side) : bool =
  forall (kid : int),
       g.`H7_pkg_PRF.`PRF_kid_ < kid
    =>    g.`H7_pkg_PRF.`PRF_d_H.[kid] = None
       /\ g.`H7_pkg_PRF.`PRF_d_LTK.[kid] = None.

op GameInv_sessions__above__counter__empty_of_H7 (g : H7_side) : bool =
  forall (ctr : int),
       g.`H7_pkg_KX.`KX_noprfkey_ctr_ < ctr
    =>    g.`H7_pkg_KX.`KX_noprfkey_d_State.[ctr] = None
       /\ g.`H7_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = None.

op GameInv_session__key__is__defined_of_H7 (g : H7_side) : bool =
  forall (ctr : int),
    let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => !(g.`H7_pkg_PRF.`PRF_d_H.[(oget state).`4] = None).

op GameInv_fresh__accepted__first__has__second_of_H7 (g : H7_side) : bool =
     g.`H7_const_bmac
  => forall (sid : (int * int * bits_n * bits_n * bits_n)),
       let d_first = g.`H7_pkg_KX.`KX_noprfkey_d_First.[sid] in
            !(d_first = None)
         => let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[oget d_first] in
                    !(state = None)
                 /\ g.`H7_pkg_KX.`KX_noprfkey_d_Fresh.[oget d_first] = Some true
                 /\ (oget state).`5 = Some true
              => !(g.`H7_pkg_KX.`KX_noprfkey_d_Second.[sid] = None).

op GameInv_session__freshness__matches__honesty_of_H7 (g : H7_side) : bool =
  forall (ctr : int),
    let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => g.`H7_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = g.`H7_pkg_PRF.`PRF_d_H.[(oget state).`4].

op GameInv_early__fresh__session__has__no__complete__transcript_of_H7 (g : H7_side) : bool =
  forall (ctr : int),
    let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[ctr] in
            !(state = None)
         /\ g.`H7_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = Some true
      => let role = (oget state).`2 in
           let nr = (oget state).`8 in
             let sid = (oget state).`10 in
               let mess = (oget state).`11 in
                    (      !role
                        /\ mess < 2
                     =>    nr = None
                        /\ sid = None)
                 /\ (      role
                        /\ mess = 0
                     => sid = None).

op GameInv_mac3__entry__authenticates__first_of_H7 (g : H7_side) : bool =
     g.`H7_const_bmac
  => forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
       let handle = (kid, d_U, d_V, ni, nr) in
         let mac2 = g.`H7_pkg_MAC.`MAC_d_Values.[((kid, d_U, d_V, ni, nr), (nr, 2))] in
           let mac3 = g.`H7_pkg_MAC.`MAC_d_Values.[((kid, d_U, d_V, ni, nr), (ni, 3))] in
                !(mac3 = None)
             =>    !(mac2 = None)
                /\ !(g.`H7_pkg_KX.`KX_noprfkey_d_First.[(d_U, d_V, ni, nr, oget mac2)] = None).

op GameInv_mac4__entry__authenticates__second_of_H7 (g : H7_side) : bool =
     g.`H7_const_bmac
  => let zero = zero_n in
       forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
         let mac2 = g.`H7_pkg_MAC.`MAC_d_Values.[((kid, d_U, d_V, ni, nr), (nr, 2))] in
           let mac4 = g.`H7_pkg_MAC.`MAC_d_Values.[((kid, d_U, d_V, ni, nr), (zero, 4))] in
                !(mac4 = None)
             =>    !(mac2 = None)
                /\ !(g.`H7_pkg_KX.`KX_noprfkey_d_Second.[(d_U, d_V, ni, nr, oget mac2)] = None).

op GameInv_mac__values__are__correct_of_H7 (g : H7_side) : bool =
  forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
    let handle = (kid, d_U, d_V, ni, nr) in
      let value = (nr, 2) in
           !(g.`H7_pkg_MAC.`MAC_d_Values.[(handle, value)] = None)
        =>    !(g.`H7_pkg_MAC.`MAC_d_Keys.[handle] = None)
           /\ g.`H7_pkg_MAC.`MAC_d_Values.[(handle, value)] = Some (func_mac (oget g.`H7_pkg_MAC.`MAC_d_Keys.[handle]) nr 2).

op GameInv_fresh__sid__authenticated__by__mac2_of_H7 (g : H7_side) : bool =
     g.`H7_const_bmac
  => forall (ctr : int),
       let state = g.`H7_pkg_KX.`KX_noprfkey_d_State.[ctr] in
               !(state = None)
            /\ g.`H7_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = Some true
         => let d_U = (oget state).`1 in
              let d_V = (oget state).`3 in
                let kid = (oget state).`4 in
                  let ni = (oget state).`7 in
                    let nr = (oget state).`8 in
                      let sid = (oget state).`10 in
                              !(ni = None)
                           /\ !(nr = None)
                           /\ !(sid = None)
                        => let tau = (oget sid).`5 in
                                oget sid = (d_U, d_V, oget ni, oget nr, tau)
                             /\ g.`H7_pkg_MAC.`MAC_d_Values.[((kid, d_U, d_V, oget ni, oget nr), (oget nr, 2))] = Some tau.

op side_inv_H7 (s : H7_side) : bool =
     !s.`H7_abort_flag
  =>    links_H7 s
     /\ GameInv_first__points__to__state_of_H7 s
     /\ GameInv_first__entry__after__message1_of_H7 s
     /\ GameInv_keys__above__counter__empty_of_H7 s
     /\ GameInv_sessions__above__counter__empty_of_H7 s
     /\ GameInv_session__key__is__defined_of_H7 s
     /\ GameInv_fresh__accepted__first__has__second_of_H7 s
     /\ GameInv_session__freshness__matches__honesty_of_H7 s
     /\ GameInv_early__fresh__session__has__no__complete__transcript_of_H7 s
     /\ GameInv_mac3__entry__authenticates__first_of_H7 s
     /\ GameInv_mac4__entry__authenticates__second_of_H7 s
     /\ GameInv_mac__values__are__correct_of_H7 s
     /\ GameInv_fresh__sid__authenticated__by__mac2_of_H7 s.
