(* Comp_H7.ec for theorem `Full4WHS`, composition `H7` — generated by `domino easycrypt`. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Pkg_PRF Pkg_MAC Pkg_Nonces Pkg_ReductionMac Pkg_KX_noprfkey.
require import Pkg_PRF Pkg_MAC Pkg_Nonces Pkg_ReductionMac Pkg_KX_noprfkey.

clone Pkg_PRF as Cloned_Pkg_PRF.

clone Pkg_MAC as Cloned_Pkg_MAC.

clone Pkg_Nonces as Cloned_Pkg_Nonces.

clone Pkg_ReductionMac as Cloned_Pkg_Prot.

clone Pkg_KX_noprfkey as Cloned_Pkg_KX.

module Pkg_Inst_PRF = Cloned_Pkg_PRF.PRF.

module Pkg_Inst_MAC = Cloned_Pkg_MAC.MAC.

module Pkg_Inst_Nonces = Cloned_Pkg_Nonces.Nonces.

module Pkg_Imports_Prot : Pkg_ReductionMac.ReductionMac_Imports = {
  proc d_Eval(kid : int, x : (int * int * bits_n * bits_n * bool)) : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_PRF.d_Eval(kid, x);
    return r;
  }

  proc d_Hon(h : int) : bool option = {
    var r : bool option;
    r <@ Pkg_Inst_PRF.d_Hon(h);
    return r;
  }

  proc d_Init(handle : (int * int * int * bits_n * bits_n)) : unit option = {
    var r : unit option;
    r <@ Pkg_Inst_MAC.d_Init(handle);
    return r;
  }

  proc d_Mac(handle : (int * int * int * bits_n * bits_n), value : (bits_n * int)) : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_MAC.d_Mac(handle, value);
    return r;
  }

  proc d_Sample() : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_Nonces.d_Sample();
    return r;
  }

  proc d_Verify(handle : (int * int * int * bits_n * bits_n), value : (bits_n * int), tag : bits_n) : bool option = {
    var r : bool option;
    r <@ Pkg_Inst_MAC.d_Verify(handle, value, tag);
    return r;
  }
}.

module Pkg_Inst_Prot = Cloned_Pkg_Prot.ReductionMac(Pkg_Imports_Prot).

module Pkg_Imports_KX : Pkg_KX_noprfkey.KX_noprfkey_Imports = {
  proc d_Eval(h : int, x : (int * int * bits_n * bits_n * bool)) : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_PRF.d_Eval(h, x);
