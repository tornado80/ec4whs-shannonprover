(* Comp_H6.ec for theorem `Full4WHS`, composition `H6` — generated by `domino easycrypt`. *)

require import AllCore Distr FMap Int IntDiv Types.
require Interfaces Pkg_PRF Pkg_Nonces Pkg_ProtNoKeyOnlyKid Pkg_KX_noprfkey.
require import Pkg_PRF Pkg_Nonces Pkg_ProtNoKeyOnlyKid Pkg_KX_noprfkey.

clone Pkg_PRF as Cloned_Pkg_PRF.

clone Pkg_Nonces as Cloned_Pkg_Nonces.

clone Pkg_ProtNoKeyOnlyKid as Cloned_Pkg_Prot.

clone Pkg_KX_noprfkey as Cloned_Pkg_KX.

module Pkg_Inst_PRF = Cloned_Pkg_PRF.PRF.

module Pkg_Inst_Nonces = Cloned_Pkg_Nonces.Nonces.

module Pkg_Imports_Prot : Pkg_ProtNoKeyOnlyKid.ProtNoKeyOnlyKid_Imports = {
  proc d_Eval(kid : int, x : (int * int * bits_n * bits_n * bool)) : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_PRF.d_Eval(kid, x);
    return r;
  }

  proc d_Sample() : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_Nonces.d_Sample();
    return r;
  }
}.

module Pkg_Inst_Prot = Cloned_Pkg_Prot.ProtNoKeyOnlyKid(Pkg_Imports_Prot).

module Pkg_Imports_KX : Pkg_KX_noprfkey.KX_noprfkey_Imports = {
  proc d_Eval(h : int, x : (int * int * bits_n * bits_n * bool)) : bits_n option = {
    var r : bits_n option;
    r <@ Pkg_Inst_PRF.d_Eval(h, x);
    return r;
  }

  proc d_Hon(h : int) : bool option = {
    var r : bool option;
    r <@ Pkg_Inst_PRF.d_Hon(h);
    return r;
  }

  proc d_Run1(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option;
    r <@ Pkg_Inst_Prot.d_Run1(state);
    return r;
  }

  proc d_Run2(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), ni : bits_n) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option;
    r <@ Pkg_Inst_Prot.d_Run2(state, ni);
    return r;
  }

  proc d_Run3(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), msg : (bits_n * bits_n)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * (bits_n * bits_n)) option;
    r <@ Pkg_Inst_Prot.d_Run3(state, msg);
    return r;
  }

  proc d_Run4(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), msg : (bits_n * bits_n)) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bits_n) option;
    r <@ Pkg_Inst_Prot.d_Run4(state, msg);
    return r;
  }

  proc d_Run5(state : (int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int), tau : bits_n) : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bool) option = {
    var r : ((int * bool * int * int * bool option * bits_n option * bits_n option * bits_n option * bits_n option * (int * int * bits_n * bits_n * bits_n) option * int) * bool) option;
    r <@ Pkg_Inst_Prot.d_Run5(state, tau);
    return r;
  }
}.

module Pkg_Inst_KX = Cloned_Pkg_KX.KX_noprfkey(Pkg_Imports_KX).

module Game_H6 : Interfaces.Iface_H0 = {
  var abort_flag : bool

  proc init(bleast : bool, bprf : bool, btest : bool) : unit = {
    abort_flag <- false;
    Pkg_Inst_PRF.init(bprf);
    Pkg_Inst_Nonces.init(true);
    Pkg_Inst_KX.init(btest, bleast);
  }

  proc d_NewKey(ltk : bits_n option) : int option = {
    var ec_result : int option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_PRF.d_NewKey(ltk);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_NewSession(d_U : int, u : bool, d_V : int, kid : int) : int option = {
    var ec_result : int option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_NewSession(d_U, u, d_V, kid);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send1(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send1(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send2(ctr : int, msg : bits_n) : (bits_n * bits_n) option = {
    var ec_result : (bits_n * bits_n) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send2(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send3(ctr : int, msg : (bits_n * bits_n)) : (bits_n * bits_n) option = {
    var ec_result : (bits_n * bits_n) option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send3(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send4(ctr : int, msg : (bits_n * bits_n)) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send4(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Send5(ctr : int, msg : bits_n) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Send5(ctr, msg);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Reveal(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Reveal(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_Test(ctr : int) : bits_n option = {
    var ec_result : bits_n option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_Test(ctr);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_SameKey(ctr1 : int, ctr2 : int) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_SameKey(ctr1, ctr2);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_AtMost(ctr1 : int, ctr2 : int, ctr3 : int) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_AtMost(ctr1, ctr2, ctr3);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }

  proc d_AtLeast(sid : (int * int * bits_n * bits_n * bits_n)) : bool option = {
    var ec_result : bool option <- None;
    if (!abort_flag) {
      ec_result <@ Pkg_Inst_KX.d_AtLeast(sid);
      if (ec_result = None) {
        abort_flag <- true;
      }
    }
    return ec_result;
  }
}.

module Exp_H6 (A : Interfaces.Adv_H0) = {
  proc run(bleast : bool, bprf : bool, btest : bool) : bool = {
    var b' : bool;
    Game_H6.init(bleast, bprf, btest);
    b' <@ A(Game_H6).run();
    return b';
  }
}.

type H6_side = {
  H6_pkg_PRF : PRF_pkgstate;
  H6_pkg_Nonces : Nonces_pkgstate;
  H6_pkg_KX : KX_noprfkey_pkgstate;
  H6_params_PRF : PRF_pkgparams;
  H6_params_Nonces : Nonces_pkgparams;
  H6_params_Prot : ProtNoKeyOnlyKid_pkgparams;
  H6_params_KX : KX_noprfkey_pkgparams;
  H6_const_bleast : bool;
  H6_const_bprf : bool;
  H6_const_btest : bool;
  H6_abort_flag : bool
}.

op links_H6 (s : H6_side) : bool =
     s.`H6_params_PRF.`PRF_param_b = s.`H6_const_bprf
  /\ s.`H6_params_Nonces.`Nonces_param_b = true
  /\ s.`H6_params_KX.`KX_noprfkey_param_btest = s.`H6_const_btest
  /\ s.`H6_params_KX.`KX_noprfkey_param_bleast = s.`H6_const_bleast.

op GameInv_stuff__not__initialized__early_of_H6 (g : H6_side) : bool =
  forall (ctr : int),
    let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => let d_U = (oget state).`1 in
           let u = (oget state).`2 in
             let d_V = (oget state).`3 in
               let ltk = (oget state).`4 in
                 let acc = (oget state).`5 in
                   let k = (oget state).`6 in
                     let ni = (oget state).`7 in
                       let nr = (oget state).`8 in
                         let kmac = (oget state).`9 in
                           let sid = (oget state).`10 in
                             let mess = (oget state).`11 in
                               if u then if mess = 0 then sid = None /\ ni = nr /\ nr = kmac /\ kmac = None /\ acc = None else (if mess = 1 then acc = None else !(acc = None)) /\ (0 < mess => !(sid = None) /\ !(kmac = None) /\ !(ni = None) /\ !(nr = None)) else if mess = 0 then sid = None /\ ni = nr /\ nr = kmac /\ kmac = None /\ acc = None else if mess = 1 then !(ni = None) /\ acc = None /\ nr = kmac /\ kmac = None /\ sid = None else !(sid = None) /\ !(kmac = None) /\ !(ni = None) /\ !(nr = None).

op GameInv_revtesteval__populated_of_H6 (g : H6_side) : bool =
     g.`H6_const_bprf
  => forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
       let pos_prf = (kid, (d_U, d_V, ni, nr, true)) in
         let pos_rev = (kid, d_U, d_V, ni, nr) in
              (   g.`H6_pkg_PRF.`PRF_d_PRF.[pos_prf] = None
               =>    g.`H6_pkg_PRF.`PRF_d_H.[kid] = Some false
                  \/ g.`H6_pkg_KX.`KX_noprfkey_d_RevTestEval.[pos_rev] = None)
           /\ (   g.`H6_pkg_KX.`KX_noprfkey_d_RevTestEval.[pos_rev] = None
               => g.`H6_pkg_PRF.`PRF_d_PRF.[pos_prf] = None).

op GameInv_no__overwriting__prf_of_H6 (g : H6_side) : bool =
  forall (i : int),
       0 <= g.`H6_pkg_PRF.`PRF_kid_
    /\ (   g.`H6_pkg_PRF.`PRF_d_H.[i] = None
        => g.`H6_pkg_PRF.`PRF_d_LTK.[i] = None)
    /\ (   g.`H6_pkg_PRF.`PRF_d_LTK.[i] = None
        => g.`H6_pkg_PRF.`PRF_d_H.[i] = None)
    /\ (      g.`H6_pkg_PRF.`PRF_kid_ < i
           \/ i < 1
        =>    g.`H6_pkg_PRF.`PRF_d_H.[i] = None
           /\ g.`H6_pkg_PRF.`PRF_d_LTK.[i] = None).

op GameInv_kmac__before__k_of_H6 (g : H6_side) : bool =
  forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
       g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, ni, nr, false))] = None
    => g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, ni, nr, true))] = None.

op GameInv_kmac__is__wellformed_of_H6 (g : H6_side) : bool =
     g.`H6_const_bprf
  => forall (ctr : int),
       let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
            !(state = None)
         => let d_U = (oget state).`1 in
              let u = (oget state).`2 in
                let d_V = (oget state).`3 in
                  let kid = (oget state).`4 in
                    let acc = (oget state).`6 in
                      let ni = (oget state).`7 in
                        let nr = (oget state).`8 in
                          let kmac = (oget state).`9 in
                            let sid = (oget state).`10 in
                              let mess = (oget state).`11 in
                                   !(kmac = None)
                                => oget kmac = (if g.`H6_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = Some true then oget g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, oget ni, oget nr, false))] else func_prf (oget g.`H6_pkg_PRF.`PRF_d_LTK.[kid]) (d_U, d_V, oget ni, oget nr, false)).

op GameInv_kmac__requires__nonces_of_H6 (g : H6_side) : bool =
  forall (ctr : int),
    let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => let ni = (oget state).`8 in
           let nr = (oget state).`9 in
             let kmac = (oget state).`10 in
                  !(kmac = None)
               =>    !(ni = None)
                  /\ !(nr = None).

op GameInv_sid__is__wellformed_of_H6 (g : H6_side) : bool =
  forall (ctr : int),
    let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => let d_U = (oget state).`1 in
           let d_V = (oget state).`3 in
             let ni = (oget state).`7 in
               let nr = (oget state).`8 in
                 let kmac = (oget state).`9 in
                   let sid = (oget state).`10 in
                        !(sid = None)
                     => sid = Some (d_U, d_V, oget ni, oget nr, func_mac (oget kmac) (oget nr) 2).

op GameInv_honest__kmac_of_H6 (g : H6_side) : bool =
     g.`H6_const_bprf
  => forall (ctr : int),
       let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
            !(state = None)
         => let d_U = (oget state).`1 in
              let d_V = (oget state).`3 in
                let kid = (oget state).`4 in
                  let ni = (oget state).`7 in
                    let nr = (oget state).`8 in
                      let kmac = (oget state).`9 in
                           g.`H6_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = Some true
                        =>    g.`H6_pkg_PRF.`PRF_d_H.[kid] = Some true
                           /\ (   !(kmac = None)
                               => !(g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, oget ni, oget nr, false))] = None)).

op GameInv_sid__requires__nonces_of_H6 (g : H6_side) : bool =
  forall (ctr : int),
    let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => let ni = (oget state).`7 in
           let nr = (oget state).`8 in
             let sid = (oget state).`10 in
                  !(sid = None)
               =>    !(ni = None)
                  /\ !(nr = None).

op GameInv_h__and__fresh__match_of_H6 (g : H6_side) : bool =
  forall (ctr : int),
    let state = g.`H6_pkg_KX.`KX_noprfkey_d_State.[ctr] in
         !(state = None)
      => let kid = (oget state).`4 in
              !(g.`H6_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = None)
           /\ !(g.`H6_pkg_PRF.`PRF_d_H.[kid] = None)
           /\ g.`H6_pkg_KX.`KX_noprfkey_d_Fresh.[ctr] = g.`H6_pkg_PRF.`PRF_d_H.[kid].

op GameInv_k__prf__implies__rev__tested__sid_of_H6 (g : H6_side) : bool =
  forall (kid : int) (d_U : int) (d_V : int) (ni : bits_n) (nr : bits_n),
       !(g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, ni, nr, true))] = None)
    => let kmac = oget g.`H6_pkg_PRF.`PRF_d_PRF.[(kid, (d_U, d_V, ni, nr, false))] in
         let tau = func_mac kmac nr 2 in
           !(g.`H6_pkg_KX.`KX_noprfkey_d_RevTested.[(d_U, d_V, ni, nr, tau)] = None).

op side_inv_H6 (s : H6_side) : bool =
     !s.`H6_abort_flag
  =>    links_H6 s
     /\ GameInv_stuff__not__initialized__early_of_H6 s
     /\ GameInv_revtesteval__populated_of_H6 s
     /\ GameInv_no__overwriting__prf_of_H6 s
     /\ GameInv_kmac__before__k_of_H6 s
     /\ GameInv_kmac__is__wellformed_of_H6 s
     /\ GameInv_kmac__requires__nonces_of_H6 s
     /\ GameInv_sid__is__wellformed_of_H6 s
     /\ GameInv_honest__kmac_of_H6 s
     /\ GameInv_sid__requires__nonces_of_H6 s
     /\ GameInv_h__and__fresh__match_of_H6 s
     /\ GameInv_k__prf__implies__rev__tested__sid_of_H6 s.
