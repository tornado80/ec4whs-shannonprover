(* Interfaces.ec for theorem `Full4WHS` — generated by `domino easycrypt`. *)

require import AllCore FMap Distr Int Types.

module type Iface_Nonces = {
  proc d_Sample() : bits_n option
}.

module type Adv_Nonces (O : Iface_Nonces) = {
  proc run() : bool
}.

module type Iface_CR = {
  proc d_MAC(k : bits_n, nonce : bits_n, i : int) : bits_n option
  proc d_PRF(k : bits_n, x : (int * int * bits_n * bits_n * bool)) : bits_n option
}.

module type Adv_CR (O : Iface_CR) = {
  proc run() : bool
}.

module type Iface_PRF = {
  proc d_NewKey(ltk : bits_n option) : int option
  proc d_Eval(kid : int, x : (int * int * bits_n * bits_n * bool)) : bits_n option
  proc d_Hon(kid : int) : bool option
}.

module type Adv_PRF (O : Iface_PRF) = {
  proc run() : bool
}.

module type Iface_MAC = {
  proc d_Init(handle : (int * int * int * bits_n * bits_n)) : unit option
  proc d_Mac(handle : (int * int * int * bits_n * bits_n), value : (bits_n * int)) : bits_n option
  proc d_Verify(handle : (int * int * int * bits_n * bits_n), value : (bits_n * int), tag : bits_n) : bool option
}.

module type Adv_MAC (O : Iface_MAC) = {
  proc run() : bool
}.

(* Iface_H0/Adv_H0 also cover: H1, H2, H3, H4, H5, H6, H7 *)

module type Iface_H0 = {
  proc d_NewKey(ltk : bits_n option) : int option
  proc d_NewSession(d_U : int, u : bool, d_V : int, kid : int) : int option
  proc d_Send1(ctr : int) : bits_n option
  proc d_Send2(ctr : int, msg : bits_n) : (bits_n * bits_n) option
  proc d_Send3(ctr : int, msg : (bits_n * bits_n)) : (bits_n * bits_n) option
  proc d_Send4(ctr : int, msg : (bits_n * bits_n)) : bits_n option
  proc d_Send5(ctr : int, msg : bits_n) : bool option
  proc d_Reveal(ctr : int) : bits_n option
  proc d_Test(ctr : int) : bits_n option
  proc d_SameKey(ctr1 : int, ctr2 : int) : bool option
  proc d_AtMost(ctr1 : int, ctr2 : int, ctr3 : int) : bool option
  proc d_AtLeast(sid : (int * int * bits_n * bits_n * bits_n)) : bool option
}.

module type Adv_H0 (O : Iface_H0) = {
  proc run() : bool
}.
